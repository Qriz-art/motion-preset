# ============================================================
# Contoh konfigurasi environment variable.
# Salin file ini menjadi .env.local lalu isi nilainya sendiri.
# JANGAN pernah menulis nilai asli ke file ini atau ke GitHub.
# ============================================================

# --- Wajib: kredensial Google Sheets (hanya dipakai di server) ---

# ID spreadsheet. Ambil dari URL Google Sheets:
# https://docs.google.com/spreadsheets/d/<GOOGLE_SHEETS_ID>/edit
GOOGLE_SHEETS_ID=

# Email service account, diakhiri .iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# Private key dari file JSON service account (kolom "private_key").
# Tempel apa adanya (boleh memakai \n) atau versi base64-nya.
GOOGLE_PRIVATE_KEY=

# Rentang data pada Sheet. Baris pertama dianggap header.
GOOGLE_SHEETS_RANGE=A1:E2000


# --- Opsional ---

# Secret untuk mengunci endpoint /api/process. Bila diisi, endpoint hanya
# menerima header "Authorization: Bearer <nilai ini>" (dipakai cron eksternal).
# Nilai yang sama harus disimpan sebagai secret di GitHub Actions.
CRON_SECRET=

# URL website setelah deploy, dipakai untuk SEO (sitemap & Open Graph).
# Contoh: https://motion-presets.vercel.app
NEXT_PUBLIC_SITE_URL=

# Link Google Form untuk pengiriman preset.
# Selama dikosongkan, tombol "Buka Google Form" tidak akan ditampilkan.
NEXT_PUBLIC_GOOGLE_FORM_URL=
