# Jangan jalankan lifecycle script saat instalasi dependency.
#
# Alasan:
# 1. Paket @coflyn/scrapr punya optionalDependency "playwright" yang otomatis
#    mengunduh browser (~150 MB) lewat script postinstall. Website ini hanya
#    memakai metode TikTok berbasis HTTP, jadi unduhan itu tidak diperlukan.
# 2. Menjalankan script pihak ketiga saat instalasi adalah risiko keamanan
#    yang tidak perlu untuk project ini.
#
# Semua dependency biner (lightningcss, @tailwindcss/oxide, @next/swc) sudah
# tersedia sebagai paket prebuilt, sehingga tidak butuh script instalasi.
ignore-scripts=true
